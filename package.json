{
  "name": "@fungi.computer/ear-tag",
  "version": "0.0.1",
  "author": "Levi <levi@technomancy.dev>",
  "description": "Worker-safe bearer-key generation and hashing primitives",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./grants": {
      "types": "./dist/grants.d.ts",
      "import": "./dist/grants.js"
    },
    "./keys": {
      "types": "./dist/keys.d.ts",
      "import": "./dist/keys.js"
    },
    "./keys/node": {
      "types": "./dist/keys-node.d.ts",
      "import": "./dist/keys-node.js"
    }
  },
  "files": [
    "dist",
    "docs/api",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "eslint src test --max-warnings=0 && ../../node_modules/.bin/oxlint --config ../../oxlint.config.ts --deny-warnings src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "node --input-type=module --eval \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true });\"",
    "test": "pnpm run test:node && pnpm run test:cloudflare",
    "test:node": "vitest run --config vitest.node.config.mjs",
    "test:cloudflare": "vitest run --config vitest.cloudflare.config.mjs",
    "docs": "tsx ../../tooling/repository/src/docs/cli.ts check --root ../..",
    "docs:write": "tsx ../../tooling/repository/src/docs/cli.ts write --root ../..",
    "pack": "mkdir -p ../../.botanical/ear-tag-pack && pnpm pack --pack-destination ../../.botanical/ear-tag-pack",
    "smoke": "node --input-type=module -e \"import('./dist/index.js').then(({generateKey, hashKey}) => { const key = generateKey({ prefix: 'test' }); if (!key.startsWith('test_')) process.exit(1); return hashKey(key); }).then((hash) => { if (hash.length !== 64) process.exit(1); })\"",
    "stranger": "tsx ../../tooling/repository/src/artifacts/cli.ts --repo-root ../.. .",
    "format:check": "node ../../tooling/repository/scripts/format-package-check.mjs",
    "lint:anti-slop": "node ../../tooling/repository/scripts/lint-package-anti-slop.mjs"
  },
  "dependencies": {
    "@fungi.computer/cairn": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.2",
    "@types/node": "24.13.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "botanical": {
    "role": "package",
    "operations": {
      "lint": "required",
      "typecheck": "required",
      "build": "required",
      "test": "required",
      "docs": "required",
      "pack": "required",
      "smoke": "required",
      "stranger": "required"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fungi-computer/ear-tag.git"
  }
}
